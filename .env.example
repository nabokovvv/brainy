# Required only when the Telegram bot process is started.
TELEGRAM_TOKEN=
# Bot API 10.1 rich finals; failures automatically fall back to regular messages.
TELEGRAM_RICH_MESSAGES=true

# Local inference is the only enabled route by default.
LLM_CLIENT=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Exact tag confirmed on the target Mac mini.
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=120
OLLAMA_CONTEXT_TOKENS=65536

# Voice input is preserved. Python loads lazily; whisper.cpp runs on demand.
WHISPER_BACKEND=python
WHISPER_MODEL=base
# Mac mini target:
# WHISPER_BACKEND=cpp
# WHISPER_CPP_EXECUTABLE=/opt/homebrew/bin/whisper-cli
# WHISPER_CPP_FFMPEG=/opt/homebrew/bin/ffmpeg
# WHISPER_CPP_MODEL=~/Library/Application Support/Brainy/models/whisper/ggml-large-v3.bin

# Web stays OFF by default. The DuckDuckGo-compatible backend is best-effort;
# the Web ON answer/evidence orchestration is enabled in its following slice.
WEB_ENABLED_DEFAULT=false
SEARCH_BACKEND=duckduckgo
# Optional zero-cost fallback only; keep disabled unless a distinct free adapter exists.
SEARCH_FALLBACK_BACKEND=disabled
