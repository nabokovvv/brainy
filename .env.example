# Required only when the Telegram bot process is started.
TELEGRAM_TOKEN=

# Local inference is the only enabled route by default.
LLM_CLIENT=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Provisional owner-provided name; replace it with the exact tag from `ollama list`.
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=120
OLLAMA_CONTEXT_TOKENS=65536

# Voice input is preserved; the model is loaded lazily on the first voice message.
WHISPER_MODEL=base

# Web access is opt-in and remains disabled until a zero-cost backend is configured.
WEB_ENABLED_DEFAULT=false
SEARCH_BACKEND=disabled

# Legacy Yandex support. Leave blank unless the account is guaranteed unable to charge.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Legacy adapters are disabled while LLM_CLIENT=ollama. Never add real secrets here.
TOGETHER_AI_API_KEY=
WIKIDATA_ACCESS_TOKEN=
