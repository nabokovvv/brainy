# Required only when the Telegram bot process is started.
TELEGRAM_TOKEN=

# OmniRouter is primary; local Ollama is the automatic fallback.
LLM_CLIENT=omnirouter
OMNIROUTER_BASE_URL=http://127.0.0.1:20131/v1
OMNIROUTER_API_KEY=
OMNIROUTER_MODEL=brainy-fast
OMNIROUTER_TIMEOUT=60
OMNIROUTER_CONTEXT_TOKENS=65536

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Exact tag confirmed on the target Mac mini.
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=120
OLLAMA_CONTEXT_TOKENS=65536

# Voice input on the target Mac mini uses the installed whisper.cpp large-v3 model.
WHISPER_BACKEND=cpp
WHISPER_CPP_EXECUTABLE=/opt/homebrew/bin/whisper-cli
WHISPER_CPP_FFMPEG=/opt/homebrew/bin/ffmpeg
WHISPER_CPP_MODEL=~/Library/Application Support/Brainy/models/whisper/ggml-large-v3.bin
# Development-only fallback (requires the Python package and a model download/cache):
# WHISPER_BACKEND=python
# WHISPER_MODEL=base

# Web stays OFF by default. When enabled, providers are tried sequentially in
# Tavily → Brave → SerpAPI order and the monthly quota ledger fails closed.
WEB_ENABLED_DEFAULT=false
SEARCH_BACKEND=rotation
SEARCH_FALLBACK_BACKEND=disabled
SEARCH_QUOTA_STATE_PATH=~/.local/state/brainy/search_quota.json
USER_SETTINGS_PATH=~/.local/state/brainy/settings.sqlite3

# Keep keys only in the local/remote secret environment; never commit them.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_MONTHLY_LIMIT=900
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=900
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=200

# Stage 3 discovery/canary only. Remote inference is not enabled automatically;
# a model must pass all 8 language canaries and be explicitly curated first.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Free-account and local safety ceilings used by tools/scan_remote_models.py.
NVIDIA_DAILY_LIMIT=40
OPENROUTER_DAILY_LIMIT=50
REMOTE_INFERENCE_BUDGET_PATH=~/.local/state/brainy/remote_inference_budget.json
OPENROUTER_CATALOG_PATH=~/.local/state/brainy/openrouter_catalog.json
